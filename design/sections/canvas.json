 "annotations": [
  {
   "id": "n1",
   "page": "page-1",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "HÉRO\nA est l'actuel. B libère de la place pour la démo à droite et raccourcit la page. C ouvre sur du noir : mémorable, mais plus froid dès la première seconde."
  },
  {
   "id": "n2",
   "page": "page-2",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "CAPACITÉS\nA est l'actuel, sûr mais banal. B transforme la liste en propos éditorial, plus haut de gamme. C est le plus moderne, mais hiérarchise à ta place."
  },
  {
   "id": "n3",
   "page": "page-3",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "BRANCHEMENT\nLes trois sont déjà codés et vivants sur la page labo. A parle le langage des outils d'automatisation. B est le plus crédible. C est le plus physique."
  },
  {
   "id": "n4",
   "page": "page-4",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "ÉTAPES\nA tient en peu de hauteur. B respire et se lit mieux sur mobile, mais rallonge la page."
  },
  {
   "id": "n5",
   "page": "page-5",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "COMPARATIF\nA est l'actuel, très rapide à lire. B assume la confrontation avec deux cartes, dont une éteinte."
  },
  {
   "id": "n6",
   "page": "page-6",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "SCÈNE NOIRE\nA force à faire défiler pour tout voir, ce qui crée le suspense. B donne les huit idées d'un coup : moins spectaculaire, plus utile pour un patron pressé."
  },
  {
   "id": "n7",
   "page": "page-7",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "TARIFS\nA sépare bien les trois étapes. B les met sur une seule ligne et récupère de la place pour la réassurance juste en dessous."
  },
  {
   "id": "n8",
   "page": "page-8",
   "x": 0,
   "y": -140,
   "w": 420,
   "text": "FIN\nA est sobre. B ferme le site sur du noir et propose un champ, ce qui invite plus qu'un bouton."
  }
 ],
